name: "mrcnn"
backend: "onnxruntime"
input [
  {
    name: "input_0"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]
output [
  {
    name: "boxes"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]
  },
  {
    name: "labels"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "masks"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  }
]
