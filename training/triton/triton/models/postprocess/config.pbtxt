name: "postprocess"
backend: "python"
input [
  {
    name: "boxes"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]  
  },
  {
    name: "labels"
    data_type: TYPE_INT64
    dims: [ -1 ]  
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [ -1 ] 
  },
  {
    name: "masks"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]  
  },
  {
    name: "yolo_result"
    data_type: TYPE_FP32
    dims: [ 1, 7, 8400 ]
  }
]

output [
  {
    name: "point"
    data_type: TYPE_FP32
    dims: [ -1 ]  
  },
  {
    name: "scores"
    data_type: TYPE_FP32  # 데이터 타입을 문자열로 변경
    dims: [ -1 ]  # 단일 문자열이므로 차원은 1
  }
]
